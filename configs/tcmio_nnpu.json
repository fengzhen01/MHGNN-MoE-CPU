  "train_unlabeled_ratio": 3,
  "unique_negatives": true,
  "positive_class_prior": 0.016543,
  "nnpu_beta": 0.0,
  "nnpu_gamma": 1.0,
  "threshold": 0.5,
  "early_stopping": false,
  "device": "cpu",
  "save_predictions": true
