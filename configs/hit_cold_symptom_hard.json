{
  "dataset": "HIT",
  "model": "baseline",
  "loss_mode": "bce",
  "protocol": "cold_symptom",
  "seed": 0,
  "folds": 5,
  "fold_indices": "all",
  "epochs": 100,
  "learning_rate": 0.002,
  "weight_decay": 0.0005,
  "hidden_dim": 256,
  "output_dim": 64,
  "ppi_layers": 1,
  "hyper_layers": 2,
  "dropout": 0.5,
  "negative_top_n": 50,
  "network_negative_probability": 1.0,
  "unique_negatives": true,
  "train_negative_strategy": "network_close",
  "validation_negative_strategy": "network_close",
  "train_unlabeled_ratio": 1,
  "allow_proximity_router": false,
  "threshold": 0.5,
  "early_stopping": false,
  "device": "cpu",
  "save_predictions": true
}
